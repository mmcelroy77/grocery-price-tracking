# rcfile for scripts/dev_shell.sh: normal bash config + project venv.
[[ -f ~/.bashrc ]] && source ~/.bashrc
export PATH="$HOME/.local/bin:$PATH"   # uv
export UV_LINK_MODE=copy               # project may live on /mnt/c
source "$PROJECT_ROOT/.venv/bin/activate"
cd "$PROJECT_ROOT"
echo "grocery-price-tracking dev shell (venv active). Type 'exit' to leave."
